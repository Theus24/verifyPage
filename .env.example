# Copy to .env and fill values (DO NOT commit real secrets)
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
VERIFIED_ROLE_ID=role_id_for_Verified
UNVERIFIED_ROLE_ID=role_id_for_Unverified
# Public base url of this server (no trailing slash), used for redirect URI and embed link
BASE_URL=https://example.com
# Port to run express server on
PORT=3000
